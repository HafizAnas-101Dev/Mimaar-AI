# Where the models run: "meta" = Meta Model API (needs MODEL_API_KEY),
# "local" = Meta open weights on this PC (Muse Glimmer via llama.cpp, SAM 3 via transformers).
MODEL_BACKEND=meta

# --- Meta Model API (MODEL_BACKEND=meta). Leave the key empty to run fully in mock mode. ---
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.3
SAM_MODEL=sam-3.1

# --- Local open weights (MODEL_BACKEND=local). Start the "glimmer" server first. ---
LOCAL_LLM_URL=http://127.0.0.1:8080/v1
LOCAL_LLM_MODEL=muse-glimmer-30b
LOCAL_SAM_MODEL=facebook/sam3
# How long Muse Glimmer thinks before answering: none (fastest) | low | medium | high
LOCAL_REASONING=none
# Hugging Face read token, after facebook/sam3 grants you access (needed for PERCEIVER=sam_local)
HF_TOKEN=
# Seconds to wait for one model reply (default 900 local, 90 Meta API)
# MODEL_TIMEOUT_S=900

# Perception: muse (boxes from the reasoning model), sam (SAM 3.1 over the API),
# sam_local (SAM 3 on this PC) or mock
PERCEIVER=muse
# Force mock mode even when a model is available (true/false)
MIMAAR_MOCK=false
# Longest image side sent to the models, in pixels
MAX_IMAGE_SIDE=1280
